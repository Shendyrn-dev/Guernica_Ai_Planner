# OpenRouter (free + best PRD) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Best free for PRD; alternatives: google/gemini-2.0-flash-exp:free, anthropic/claude-3.5-haiku, deepseek/deepseek-r1:free
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FAST_MODEL=google/gemini-2.0-flash-exp:free
# Fast + short: google/gemini-2.0-flash-exp:free, anthropic/claude-3.5-haiku, openai/gpt-4o-mini
CLARIFY_TIMEOUT_MS=25000
PLAN_TIMEOUT_MS=55000
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_TITLE=AI Planner

